<!DOCTYPE html>
<html lang="en" class="h-full bg-base-200/50">
<head>
    <%- include('partials/head', { title: 'Admin Panel - Apps Loader' }) %>
</head>

<body class="min-h-full font-sans text-base-content antialiased flex flex-col">

    <!-- Top Admin Bar -->
    <nav class="navbar bg-base-100 border-b border-base-200 sticky top-0 z-40 px-4 sm:px-8">
        <div class="navbar-start gap-2">
            <a href="/admin" class="flex items-center gap-2 font-bold text-lg">
                <span class="badge badge-neutral font-mono text-xs">ADMIN</span>
                <span>Control Center</span>
            </a>
        </div>
        <div class="navbar-end gap-2">
            <a href="/dashboard" class="btn btn-ghost btn-sm gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Dashboard
            </a>
            <a href="/logout" class="btn btn-ghost btn-circle btn-sm text-error" title="Logout">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </a>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-8 sm:py-10 px-4 sm:px-6 lg:px-8 space-y-8 flex-1 w-full">

        <!-- Global Settings Card -->
        <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl">
            <div class="card-body p-6">
                <h2 class="card-title text-base font-bold text-base-content flex items-center gap-2 mb-2">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    System Policies
                </h2>
                <form action="/admin/settings" method="POST" class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-base-200/50 p-4 rounded-xl border border-base-200">
                    <div class="flex items-center gap-3">
                        <input id="autoApprove" name="autoApprove" type="checkbox" <%= autoApprove ? 'checked' : '' %> class="toggle toggle-primary">
                        <label for="autoApprove" class="cursor-pointer">
                            <span class="text-sm font-semibold text-base-content block">Auto-approve new user registrations</span>
                            <span class="text-xs text-base-content/60 block">When active, newly registered accounts can immediately deploy applications without manual review.</span>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-neutral btn-sm shrink-0">Save Policy</button>
                </form>
            </div>
        </div>

        <!-- User Management Table -->
        <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl overflow-hidden">
            <div class="p-6 border-b border-base-200 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold text-base-content">User Accounts</h2>
                    <p class="text-xs text-base-content/60">Manage permissions and approval state for users</p>
                </div>
                <span class="badge badge-neutral font-mono text-xs"><%= users.length %> Users</span>
            </div>

            <div class="overflow-x-auto">
                <table class="table table-zebra w-full text-sm">
                    <thead class="bg-base-200/60 text-xs font-semibold uppercase text-base-content/70">
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td class="font-bold text-base-content flex items-center gap-2.5">
                                    <div class="avatar placeholder">
                                        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary text-xs font-bold flex items-center justify-center">
                                            <%= (u.username || 'U').charAt(0).toUpperCase() %>
                                        </div>
                                    </div>
                                    <span><%= u.username %></span>
                                </td>
                                <td>
                                    <span class="badge badge-sm font-mono text-xs <%= u.role === 'admin' ? 'badge-neutral' : 'badge-ghost' %>">
                                        <%= u.role %>
                                    </span>
                                </td>
                                <td>
                                    <% if (u.is_approved) { %>
                                        <span class="badge badge-success badge-sm gap-1 text-[11px] font-medium">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            Approved
                                        </span>
                                    <% } else { %>
                                        <span class="badge badge-warning badge-sm gap-1 text-[11px] font-medium">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            Pending
                                        </span>
                                    <% } %>
                                </td>
                                <td class="text-right">
                                    <% if (u.role !== 'admin') { %>
                                        <form action="/admin/approve" method="POST" class="inline">
                                            <input type="hidden" name="userId" value="<%= u.id %>">
                                            <button name="action" value="<%= u.is_approved ? 'revoke' : 'approve' %>" class="btn btn-xs <%= u.is_approved ? 'btn-ghost text-error hover:bg-error/10' : 'btn-success text-white' %>">
                                                <%= u.is_approved ? 'Revoke Access' : 'Approve Account' %>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-xs text-base-content/40 italic">Protected</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- App Management (Featured Content) -->
        <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl overflow-hidden">
            <div class="p-6 border-b border-base-200 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold text-base-content">Deployed Applications & Featured Showcase</h2>
                    <p class="text-xs text-base-content/60">Control which applications appear prominently on the public hub</p>
                </div>
                <span class="badge badge-neutral font-mono text-xs"><%= apps.length %> Apps</span>
            </div>

            <div class="overflow-x-auto">
                <table class="table table-zebra w-full text-sm">
                    <thead class="bg-base-200/60 text-xs font-semibold uppercase text-base-content/70">
                        <tr>
                            <th>Title & Slug</th>
                            <th>Author</th>
                            <th class="text-center">Featured on Hub</th>
                            <th class="text-right">Direct Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (apps.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-8 text-base-content/50 text-xs">No applications deployed yet.</td>
                            </tr>
                        <% } %>
                        <% apps.forEach(app => { %>
                            <tr>
                                <td>
                                    <div class="font-bold text-base-content"><%= app.title || app.slug %></div>
                                    <div class="font-mono text-xs text-base-content/50">/sites/<%= app.slug %>/</div>
                                </td>
                                <td>
                                    <span class="badge badge-ghost badge-sm"><%= app.author %></span>
                                </td>
                                <td class="text-center">
                                    <form action="/admin/feature" method="POST" class="inline-flex items-center justify-center">
                                        <input type="hidden" name="appId" value="<%= app.id %>">
                                        <input type="checkbox" name="isFeatured" onchange="this.form.submit()" <%= app.is_featured ? 'checked' : '' %> class="toggle toggle-warning toggle-sm">
                                    </form>
                                </td>
                                <td class="text-right">
                                    <a href="/sites/<%= app.slug %>/" target="_blank" class="btn btn-ghost btn-sm text-primary gap-1">
                                        Open Site ↗
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</body>
</html>