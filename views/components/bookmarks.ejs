<div class="divider my-10 text-sm font-semibold text-base-content/50 uppercase tracking-widest">
    Bookmarks & Resources
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pb-12">
    <!-- Left Column: Add Bookmark Form & PIN Configuration -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Add Bookmark Card -->
        <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl sticky top-24">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="card-title text-base font-bold text-base-content flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                        </div>
                        Add Bookmark
                    </h3>
                    <button type="button" onclick="toggleMetadata()" class="link link-hover text-xs font-semibold text-primary">
                        Manual Entry
                    </button>
                </div>

                <form action="/bookmarks/create" method="POST" class="space-y-4">
                    <!-- URL Input -->
                    <div class="form-control">
                        <label class="label pt-0 pb-1">
                            <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">Website URL</span>
                        </label>
                        <div class="join w-full">
                            <input type="url" id="bookmarkUrl" name="url" required placeholder="https://github.com" class="join-item input input-bordered input-sm sm:input-md w-full focus:input-secondary text-sm" onblur="fetchPreview()">
                            <button type="button" id="fetchBtn" onclick="fetchPreview()" class="join-item btn btn-sm sm:btn-md btn-neutral">
                                Auto-Fill
                            </button>
                        </div>
                    </div>

                    <!-- Visibility Toggles -->
                    <div class="bg-base-200/50 p-3 rounded-xl space-y-2 border border-base-200">
                        <label class="label cursor-pointer py-0.5">
                            <span class="label-text text-xs font-medium text-base-content flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                Public on Hub
                            </span>
                            <input id="isPublic" name="isPublic" type="checkbox" checked class="checkbox checkbox-primary checkbox-sm">
                        </label>
                        <label class="label cursor-pointer py-0.5 border-t border-base-200 pt-1.5">
                            <span class="label-text text-xs font-medium text-error flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                PIN-Protected Vault
                            </span>
                            <input id="isProtected" name="isProtected" type="checkbox" class="checkbox checkbox-error checkbox-sm">
                        </label>
                    </div>

                    <!-- Metadata Section (Shown after fetch or manual click) -->
                    <div id="metadataSection" class="hidden space-y-3 pt-2 border-t border-base-200 transition-all">
                        <div class="form-control">
                            <label class="label pt-0 pb-1">
                                <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">Custom Title</span>
                            </label>
                            <input type="text" name="title" id="bmTitle" class="input input-bordered input-sm w-full" placeholder="Site title">
                        </div>

                        <div class="form-control">
                            <label class="label pt-0 pb-1">
                                <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">Icon URL</span>
                            </label>
                            <div class="flex items-center gap-2">
                                <div class="avatar placeholder">
                                    <div class="w-9 h-9 rounded-lg bg-base-200 border border-base-300 p-1 flex items-center justify-center">
                                        <img id="bmPreviewIcon" src="/favicon.png" class="w-6 h-6 object-contain" onerror="this.src='/favicon.png'">
                                    </div>
                                </div>
                                <input type="text" name="icon" id="bmIcon" oninput="updateIconPreview(this.value)" class="input input-bordered input-sm flex-1 text-xs" placeholder="https://.../favicon.ico">
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="saveBmBtn" class="btn btn-secondary w-full shadow-sm gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Save Bookmark
                    </button>
                </form>

                <!-- Vault PIN Setting Accordion -->
                <div class="collapse collapse-arrow bg-base-200/50 border border-base-200 rounded-xl mt-4">
                    <input type="checkbox"> 
                    <div class="collapse-title text-xs font-bold text-base-content/70 flex items-center gap-1.5 py-3">
                        <svg class="w-4 h-4 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                        Security Vault PIN Setup
                    </div>
                    <div class="collapse-content pb-4">
                        <form action="/settings/pin" method="POST" class="space-y-2 pt-2">
                            <p class="text-[11px] text-base-content/60">Set a 4+ digit PIN to protect and unlock private bookmarks on the homepage.</p>
                            <div class="join w-full">
                                <input type="password" name="pin" maxlength="8" minlength="4" required placeholder="PIN (4-8 digits)" class="join-item input input-bordered input-sm w-full font-mono text-center tracking-widest">
                                <button type="submit" class="join-item btn btn-sm btn-error text-white">Save PIN</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Bookmarks List -->
    <div class="lg:col-span-2">
        <% if (bookmarks.length === 0) { %>
            <div class="card bg-base-100 border-2 border-dashed border-base-200 p-12 text-center rounded-2xl">
                <div class="card-body items-center p-0">
                    <div class="w-14 h-14 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40 mb-3">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    </div>
                    <h3 class="font-bold text-base text-base-content">No bookmarks saved yet</h3>
                    <p class="text-xs text-base-content/60 max-w-xs mt-1">Add your favorite links, documentation, and tools using the form on the left.</p>
                </div>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <% bookmarks.forEach(bm => { %>
                    <div class="card bg-base-100 shadow-sm border border-base-200 hover:border-secondary/40 hover:shadow-md transition-all rounded-xl p-4 flex flex-row items-center justify-between gap-3">
                        <a href="<%= bm.url %>" target="_blank" class="flex items-center gap-3 min-w-0 flex-1 group">
                            <div class="avatar placeholder">
                                <div class="w-10 h-10 rounded-xl bg-base-200 border border-base-300 p-1.5 flex items-center justify-center shrink-0">
                                    <img src="<%= bm.icon || ('https://www.google.com/s2/favicons?sz=64&domain=' + encodeURIComponent(bm.url)) %>" class="w-full h-full object-contain" onerror="this.src='/favicon.png'">
                                </div>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <h4 class="text-sm font-bold text-base-content truncate group-hover:text-secondary transition-colors">
                                        <%= bm.title || 'Untitled Bookmark' %>
                                    </h4>
                                    <% if (bm.is_protected) { %>
                                        <span class="badge badge-error badge-xs font-mono text-[9px]">Vault</span>
                                    <% } %>
                                </div>
                                <p class="text-xs font-mono text-base-content/50 truncate mt-0.5">
                                    <%= bm.url %>
                                </p>
                            </div>
                        </a>
                        <form action="/bookmarks/delete" method="POST" onsubmit="return confirm('Delete this bookmark?');" class="shrink-0">
                            <input type="hidden" name="id" value="<%= bm.id %>">
                            <button type="submit" class="btn btn-ghost btn-circle btn-sm text-base-content/40 hover:text-error hover:bg-error/10" title="Delete bookmark">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </form>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>