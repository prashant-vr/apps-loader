<% if (user.is_approved === 1) { %>
<div class="card bg-base-100 shadow-sm border border-base-200 sticky top-24 rounded-2xl">
    <div class="card-body p-6">
        <h3 class="card-title text-base font-bold text-base-content flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            </div>
            Deploy New App
        </h3>

        <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div class="form-control">
                <label class="label pt-0 pb-1">
                    <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">Project Title</span>
                </label>
                <input type="text" name="title" placeholder="e.g. Traffic Report Generator" class="input input-bordered input-sm sm:input-md w-full focus:input-primary">
            </div>

            <div class="form-control">
                <label class="label pt-0 pb-1">
                    <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">URL Slug</span>
                </label>
                <div class="join w-full">
                    <span class="join-item btn btn-sm sm:btn-md btn-disabled bg-base-200 text-base-content/60 font-mono text-xs">/sites/</span>
                    <input type="text" name="slug" id="slugInput" required placeholder="my-app" oninput="sanitizeInput(this)" class="join-item input input-bordered input-sm sm:input-md w-full focus:input-primary font-mono text-xs sm:text-sm">
                </div>
                <label class="label pb-0 pt-1">
                    <span class="label-text-alt font-mono text-primary text-[11px] truncate" id="slugPreview">Preview: /sites/.../</span>
                </label>
            </div>

            <div class="form-control">
                <label class="label pt-0 pb-1">
                    <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">HTML Source File</span>
                </label>
                <input id="htmlFile" name="htmlFile" type="file" accept=".html" required onchange="updateFileName(this)" class="file-input file-input-bordered file-input-primary file-input-sm sm:file-input-md w-full">
                <label class="label pb-0 pt-1">
                    <span class="label-text-alt text-base-content/50 text-[11px]" id="fileNameDisplay">Upload single .html file with bundled assets</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-full shadow-sm gap-2 mt-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                Deploy Application
            </button>
        </form>
    </div>
</div>
<% } else { %>
<div class="alert alert-warning shadow-sm rounded-2xl">
    <svg class="w-6 h-6 stroke-current shrink-0" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <div>
        <h3 class="font-bold text-sm">Account Pending Approval</h3>
        <div class="text-xs">Your account must be approved by an administrator before deploying applications.</div>
    </div>
</div>
<% } %>