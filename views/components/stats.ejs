<div class="stats stats-vertical sm:stats-horizontal shadow-sm border border-base-200 bg-base-100 w-full mb-8 rounded-2xl overflow-hidden">
    <!-- Projects Count -->
    <div class="stat">
        <div class="stat-figure text-primary">
            <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </div>
        <div class="stat-title text-xs font-semibold uppercase tracking-wider text-base-content/60">Total Deployments</div>
        <div class="stat-value text-primary"><%= apps.length %></div>
        <div class="stat-desc text-xs text-base-content/60">Hosted HTML Apps</div>
    </div>

    <!-- Bookmarks Count -->
    <div class="stat">
        <div class="stat-figure text-secondary">
            <svg class="w-8 h-8 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        </div>
        <div class="stat-title text-xs font-semibold uppercase tracking-wider text-base-content/60">Saved Bookmarks</div>
        <div class="stat-value text-secondary"><%= bookmarks.length %></div>
        <div class="stat-desc text-xs text-base-content/60">Links & Resources</div>
    </div>

    <!-- Account Status -->
    <div class="stat">
        <div class="stat-figure">
            <% if (user.is_approved) { %>
                <div class="w-3 h-3 rounded-full bg-success animate-pulse"></div>
            <% } else { %>
                <div class="w-3 h-3 rounded-full bg-warning animate-pulse"></div>
            <% } %>
        </div>
        <div class="stat-title text-xs font-semibold uppercase tracking-wider text-base-content/60">Account Status</div>
        <div class="stat-value text-lg mt-1">
            <% if (user.is_approved) { %>
                <span class="badge badge-success badge-lg font-medium text-xs gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Active & Approved
                </span>
            <% } else { %>
                <span class="badge badge-warning badge-lg font-medium text-xs gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Awaiting Approval
                </span>
            <% } %>
        </div>
        <div class="stat-desc text-xs text-base-content/60"><%= user.role === 'admin' ? 'Administrator' : 'Standard User' %></div>
    </div>
</div>