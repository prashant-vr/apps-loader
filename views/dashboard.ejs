<!DOCTYPE html>
<html lang="en" class="h-full bg-base-200/50">
<head>
    <%- include('partials/head', { title: 'Dashboard - Apps Loader' }) %>
</head>
<body class="min-h-full font-sans text-base-content antialiased flex flex-col">

    <!-- Navigation -->
    <%- include('partials/navbar', { path: '/dashboard' }) %>

    <div class="flex-1 py-8 sm:py-10">
        <!-- Header -->
        <header class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold tracking-tight text-base-content">Dashboard</h1>
                    <p class="mt-1 text-sm text-base-content/60">Manage your deployed single-page applications and saved bookmarks.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/fiddle" class="btn btn-outline btn-primary btn-sm gap-2 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                        New Fiddle
                    </a>
                    <a href="/" class="btn btn-ghost btn-sm gap-1.5 text-base-content/70">
                        View Hub ↗
                    </a>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Global Alert / Error Display -->
            <% if (error) { %>
                <div role="alert" class="alert alert-error shadow-sm mb-8 rounded-2xl">
                    <svg class="w-6 h-6 stroke-current shrink-0" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <div>
                        <h3 class="font-bold text-sm">Notice</h3>
                        <div class="text-xs"><%= error %></div>
                    </div>
                </div>
            <% } %>

            <!-- Top Stats Component -->
            <%- include('components/stats') %>

            <!-- Main App Grid Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
                <!-- Left: Deploy Form -->
                <div class="lg:col-span-1">
                    <%- include('components/deploy-form') %>
                </div>
                <!-- Right: App List -->
                <%- include('components/app-list') %>
            </div>

            <!-- Bookmarks Component -->
            <%- include('components/bookmarks') %>
        </main>
    </div>

    <!-- Page Scripts (Native Fetch & Utilities) -->
    <script>
        // 1. Slug Sanitizer
        function sanitizeInput(input) {
            const slug = input.value
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim()
                .replace(/[\s_]+/g, '-')
                .replace(/[^a-z0-9-]/g, '')
                .replace(/-+/g, '-');
            document.getElementById('slugPreview').textContent = slug ? '/sites/' + slug + '/' : 'Preview: /sites/.../';
        }

        // 2. File Input UI Update
        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            if (input.files && input.files[0]) {
                display.textContent = input.files[0].name + ' (' + (input.files[0].size / 1024).toFixed(1) + ' KB)';
                display.className = 'label-text-alt text-primary font-medium text-[11px]';
            } else {
                display.textContent = 'Upload single .html file with bundled assets';
                display.className = 'label-text-alt text-base-content/50 text-[11px]';
            }
        }

        // 3. Bookmark Logic
        function toggleMetadata() {
            const section = document.getElementById('metadataSection');
            section.classList.toggle('hidden');
        }

        function updateIconPreview(url) {
            const img = document.getElementById('bmPreviewIcon');
            img.src = url || '/favicon.png';
        }

        async function fetchPreview() {
            const urlInput = document.getElementById('bookmarkUrl');
            let url = urlInput.value.trim();
            const btn = document.getElementById('fetchBtn');
            const section = document.getElementById('metadataSection');
            
            if (!url || url.length < 4) return;

            if (!url.startsWith('http://') && !url.startsWith('https://')) {
                url = 'https://' + url;
                urlInput.value = url;
            }

            btn.textContent = 'Fetching...';
            btn.disabled = true;
            
            try {
                const res = await fetch('/api/preview-url', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url })
                });
                const data = await res.json();

                section.classList.remove('hidden');

                if (data.title) {
                    document.getElementById('bmTitle').value = data.title;
                }
                if (data.icon) {
                    document.getElementById('bmIcon').value = data.icon;
                    updateIconPreview(data.icon);
                }

                btn.textContent = 'Done';
                setTimeout(() => { 
                    btn.textContent = 'Auto-Fill'; 
                    btn.disabled = false; 
                }, 1500);
            } catch (e) {
                console.error('[Dashboard] Metadata fetch error:', e);
                section.classList.remove('hidden');
                btn.textContent = 'Manual';
                setTimeout(() => { 
                    btn.textContent = 'Auto-Fill'; 
                    btn.disabled = false; 
                }, 1500);
            }
        }
    </script>
</body>
</html>