<!DOCTYPE html>
<html lang="en" class="h-full bg-base-200/50">
<head>
    <%- include('partials/head', { title: 'Error - Apps Loader' }) %>
</head>
<body class="h-full flex items-center justify-center p-4 antialiased">
    <div class="card bg-base-100 shadow-xl border border-base-200 w-full max-w-md rounded-2xl p-6 text-center">
        <div class="w-14 h-14 rounded-2xl bg-error/10 text-error flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h1 class="text-2xl font-black text-base-content mb-2">Notice</h1>
        <p class="text-sm text-base-content/70 mb-6"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
        <div class="flex gap-2 justify-center">
            <a href="/dashboard" class="btn btn-primary btn-sm">Return to Dashboard</a>
            <a href="/" class="btn btn-ghost btn-sm">Go to Home</a>
        </div>
    </div>
</body>
</html>