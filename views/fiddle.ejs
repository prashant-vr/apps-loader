<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code Editor - Apps Loader</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link href="/style.css" rel="stylesheet">
    <style>
        textarea::-webkit-scrollbar { width: 8px; height: 8px; }
        textarea::-webkit-scrollbar-track { background: #18181b; }
        textarea::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
        textarea::-webkit-scrollbar-thumb:hover { background: #52525b; }
        .resizer {
            width: 6px;
            cursor: col-resize;
            background-color: #27272a;
            z-index: 10;
            transition: background-color 0.15s;
        }
        .resizer:hover, .resizer.active {
            background-color: #3b82f6;
        }
        /* Lock editor fonts and line-heights identically */
        .code-font {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            line-height: 1.6rem;
            font-size: 0.85rem;
        }
    </style>
</head>

<body class="bg-neutral-950 h-screen flex flex-col text-neutral-100 overflow-hidden font-sans antialiased">

    <!-- Top Navigation Bar -->
    <nav class="h-14 bg-neutral-900 border-b border-neutral-800 flex items-center justify-between px-3 sm:px-4 shrink-0">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <a href="/dashboard" class="btn btn-ghost btn-sm text-neutral-400 hover:text-white gap-1 px-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                <span class="hidden md:inline">Dashboard</span>
            </a>
            <div class="h-4 w-px bg-neutral-700 hidden sm:block"></div>
            <span class="font-bold text-sm tracking-tight hidden sm:inline-block">
                Apps<span class="text-primary font-extrabold">Fiddle</span>
            </span>

            <!-- Slug Badge -->
            <div id="slugBadgeContainer">
                <% if (prefill && prefill.slug) { %>
                    <span class="badge badge-neutral badge-sm font-mono text-[11px] text-primary">Editing: <%= prefill.slug %></span>
                <% } %>
            </div>

            <!-- Public Link to Live App (Requested: visible on save or if already saved) -->
            <a id="publicSiteLink" href="<%= prefill && prefill.slug ? '/sites/' + prefill.slug + '/' : '#' %>" target="_blank" class="btn btn-outline btn-info btn-xs sm:btn-sm gap-1.5 shadow-sm font-semibold <%= prefill && prefill.slug ? '' : 'hidden' %>" title="Open live public deployment in a new tab">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span>Open Site ↗</span>
            </a>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
            <!-- Copy All Standalone Code Button -->
            <button type="button" onclick="copyCombinedCode()" class="btn btn-ghost btn-sm text-primary hover:bg-primary/10 gap-1.5" title="Copy complete standalone HTML (HTML + CSS + JS) to clipboard">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                <span class="hidden sm:inline">Copy All</span>
            </button>

            <!-- Clear All Button -->
            <button type="button" onclick="clearAllCode()" class="btn btn-ghost btn-sm text-error/80 hover:text-error hover:bg-error/10 gap-1.5" title="Clear all editor contents">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <span class="hidden sm:inline">Clear All</span>
            </button>

            <!-- Run Code Button -->
            <button type="button" onclick="runCode()" class="btn btn-success btn-sm text-white gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <span>Run</span>
            </button>

            <!-- Save / Publish Button -->
            <button type="button" onclick="openSaveModal()" id="publishNavBtn" class="btn btn-primary btn-sm text-white gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                <span id="publishNavBtnText"><%= prefill && prefill.slug ? 'Update Deployment' : 'Publish Project' %></span>
            </button>
        </div>
    </nav>

    <!-- Split Workspace -->
    <div class="flex-1 flex overflow-hidden" id="workspace">
        <!-- Editor Panel -->
        <div id="editorPanel" class="flex flex-col min-w-[240px]" style="width: 48%;">
            <!-- Code Tabs & Editor Utilities Toolbar -->
            <div class="flex items-center bg-neutral-900 border-b border-neutral-800 text-xs font-semibold px-1 shrink-0">
                <div class="flex flex-1">
                    <button type="button" onclick="switchTab('html')" id="tab-html" class="flex-1 py-2.5 border-b-2 border-primary text-primary bg-neutral-800/60 transition-colors text-center">
                        HTML
                    </button>
                    <button type="button" onclick="switchTab('css')" id="tab-css" class="flex-1 py-2.5 border-b-2 border-transparent text-neutral-400 hover:text-white transition-colors text-center">
                        CSS
                    </button>
                    <button type="button" onclick="switchTab('js')" id="tab-js" class="flex-1 py-2.5 border-b-2 border-transparent text-neutral-400 hover:text-white transition-colors text-center">
                        JavaScript
                    </button>
                    <button type="button" onclick="switchTab('combined')" id="tab-combined" class="flex-1 py-2.5 border-b-2 border-transparent text-neutral-400 hover:text-white transition-colors text-center font-bold text-secondary">
                        Combined
                    </button>
                </div>

                <!-- Editor Action Buttons: Toggle Comment, Format, Split Tags -->
                <div class="flex items-center gap-1 pl-1">
                    <!-- Toggle Comment Button -->
                    <button type="button" onclick="toggleComment()" class="btn btn-ghost btn-xs text-neutral-400 hover:text-white gap-1 px-2 font-normal" title="Toggle Comment (Ctrl + /)">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
                        <span class="hidden md:inline">Comment</span>
                    </button>

                    <!-- Format / Tidy Indent Button -->
                    <button type="button" onclick="formatActiveCode()" class="btn btn-ghost btn-xs text-neutral-400 hover:text-white gap-1 px-2 font-normal" title="Format / Tidy Indentation">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
                        <span class="hidden md:inline">Format</span>
                    </button>

                    <!-- Split Helper Button -->
                    <button type="button" onclick="smartExtractInlineCode()" id="splitHelperBtn" class="btn btn-ghost btn-xs text-secondary hover:text-secondary-focus gap-1 hidden px-2 font-normal shrink-0" title="Extract &lt;style&gt; and &lt;script&gt; from HTML into CSS and JS tabs">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        Split Tags
                    </button>
                </div>
            </div>

            <!-- Editor Work Area with Synchronized Line Numbers Gutter -->
            <div class="relative flex-1 bg-neutral-950 overflow-hidden flex flex-row">
                <!-- Line Numbers Gutter -->
                <div id="lineNumbers" class="bg-neutral-900/90 text-neutral-500 code-font py-4 px-2 select-none text-right border-r border-neutral-800 shrink-0 overflow-hidden font-medium" style="min-width: 3rem; white-space: pre;">1</div>

                <!-- Textareas Container -->
                <div class="relative flex-1 h-full overflow-hidden">
                    <textarea id="htmlInput" class="editor-area w-full h-full bg-neutral-950 text-neutral-100 p-4 code-font resize-none focus:outline-none" spellcheck="false" wrap="off" placeholder="<!-- Write your HTML structure or paste body content here -->"></textarea>

                    <textarea id="cssInput" class="editor-area hidden w-full h-full bg-neutral-950 text-neutral-100 p-4 code-font resize-none focus:outline-none" spellcheck="false" wrap="off" placeholder="/* Write custom CSS styles here */"></textarea>

                    <textarea id="jsInput" class="editor-area hidden w-full h-full bg-neutral-950 text-neutral-100 p-4 code-font resize-none focus:outline-none" spellcheck="false" wrap="off" placeholder="// Write JavaScript code here"></textarea>

                    <textarea id="combinedInput" class="editor-area hidden w-full h-full bg-neutral-950 text-neutral-100 p-4 code-font resize-none focus:outline-none" spellcheck="false" wrap="off" placeholder="<!-- Complete All-in-One Standalone HTML (HTML + CSS + JS) -->"></textarea>
                </div>
            </div>

            <!-- Status Bar below editor -->
            <div class="h-6 bg-neutral-900 border-t border-neutral-800 flex items-center justify-between px-3 text-[11px] text-neutral-400 font-mono shrink-0 select-none">
                <div class="flex items-center gap-3">
                    <span id="cursorPos">Ln 1, Col 1</span>
                    <span class="text-neutral-700">|</span>
                    <span id="lineCount">1 lines</span>
                    <span class="text-neutral-700">|</span>
                    <span id="charCount">0 chars</span>
                </div>
                <div class="flex items-center gap-2">
                    <span id="tabModeLabel" class="uppercase text-primary font-bold text-[10px]">HTML</span>
                    <span class="text-neutral-700">|</span>
                    <span>UTF-8</span>
                </div>
            </div>
        </div>

        <!-- Col Resizer -->
        <div id="resizer" class="resizer shrink-0"></div>

        <!-- Live Preview Panel with Responsive Switcher & Console Drawer -->
        <div class="flex-1 bg-neutral-900 flex flex-col min-w-[240px] relative overflow-hidden">
            <!-- Preview Controls Bar -->
            <div class="h-9 bg-neutral-800/90 border-b border-neutral-700/80 px-3 flex items-center justify-between shrink-0 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-neutral-300 text-[11px] uppercase tracking-wider">Preview</span>
                    <!-- Viewport switcher: Desktop / Tablet / Mobile -->
                    <div class="join ml-2 bg-neutral-900 p-0.5 rounded-lg border border-neutral-700">
                        <button type="button" onclick="setPreviewViewport('100%')" id="vp-desktop" class="btn btn-ghost btn-xs text-primary join-item px-2 py-0 h-6" title="Desktop view (100%)">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </button>
                        <button type="button" onclick="setPreviewViewport('768px')" id="vp-tablet" class="btn btn-ghost btn-xs text-neutral-400 hover:text-white join-item px-2 py-0 h-6" title="Tablet view (768px)">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        </button>
                        <button type="button" onclick="setPreviewViewport('375px')" id="vp-mobile" class="btn btn-ghost btn-xs text-neutral-400 hover:text-white join-item px-2 py-0 h-6" title="Mobile view (375px)">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        </button>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <!-- Toggle Console Drawer Button -->
                    <button type="button" onclick="toggleConsoleDrawer()" id="consoleToggleBtn" class="btn btn-ghost btn-xs text-neutral-300 hover:text-white gap-1 font-mono text-[11px]" title="Toggle Interactive Console">
                        <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Console <span id="consoleBadge" class="badge badge-xs badge-neutral">0</span>
                    </button>

                    <button type="button" onclick="runCode()" class="btn btn-ghost btn-xs text-neutral-300 hover:text-white" title="Reload preview">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </button>
                </div>
            </div>

            <!-- Iframe Container with Responsive Center Wrapper -->
            <div class="flex-1 bg-neutral-950 flex items-center justify-center overflow-hidden relative">
                <div id="previewWrapper" class="w-full h-full bg-white transition-all duration-300 shadow-2xl relative">
                    <!-- Sandbox WITHOUT allow-same-origin to prevent preview scripts from redirecting or reloading the parent page -->
                    <iframe id="preview" class="w-full h-full border-none bg-white" sandbox="allow-scripts allow-modals"></iframe>
                    <div id="iframeOverlay" class="absolute inset-0 hidden z-20"></div>
                </div>
            </div>

            <!-- Interactive Console Output Drawer -->
            <div id="consoleDrawer" class="h-40 bg-neutral-950 border-t border-neutral-800 flex flex-col shrink-0 hidden transition-all">
                <div class="h-7 bg-neutral-900 border-b border-neutral-800 px-3 flex items-center justify-between text-[11px] font-mono text-neutral-400">
                    <span class="font-bold flex items-center gap-1.5 text-neutral-300">
                        <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3"/></svg>
                        Console Output
                    </span>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="clearConsoleLog()" class="hover:text-error transition-colors" title="Clear console">Clear</button>
                        <button type="button" onclick="toggleConsoleDrawer()" class="hover:text-white transition-colors" title="Close console">&times;</button>
                    </div>
                </div>
                <div id="consoleLogs" class="flex-1 p-2 font-mono text-xs overflow-y-auto space-y-1 select-text">
                    <div class="text-neutral-600 text-[11px] italic">Console is ready. Messages from console.log() will appear here.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- DaisyUI Save Modal -->
    <dialog id="save_modal" class="modal">
        <div class="modal-box bg-base-100 text-base-content max-w-sm rounded-2xl border border-base-200 shadow-2xl p-6">
            <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                <span id="modalTitleText"><%= prefill && prefill.slug ? 'Update Deployment' : 'Publish New App' %></span>
            </h3>

            <div class="space-y-3">
                <div class="form-control">
                    <label class="label py-1">
                        <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">Project Title</span>
                    </label>
                    <input type="text" id="saveTitle" value="<%= prefill && prefill.title ? prefill.title : '' %>" placeholder="e.g. My Interactive Game" class="input input-bordered input-sm w-full">
                </div>

                <div class="form-control">
                    <label class="label py-1">
                        <span class="label-text text-xs font-semibold uppercase tracking-wider text-base-content/70">App URL Slug</span>
                    </label>
                    <div class="join w-full">
                        <span class="join-item btn btn-sm btn-disabled bg-base-200 text-base-content/60 font-mono text-xs">/sites/</span>
                        <input type="text" id="saveSlug" value="<%= prefill && prefill.slug ? prefill.slug : '' %>" <%= prefill && prefill.slug ? 'readonly' : '' %> class="join-item input input-bordered input-sm w-full font-mono text-xs <%= prefill && prefill.slug ? 'bg-base-200 cursor-not-allowed' : '' %>" placeholder="my-app">
                    </div>
                    <% if (!prefill || !prefill.slug) { %>
                        <label class="label py-0.5">
                            <span class="label-text-alt text-base-content/50 text-[10px]">Leave blank for an auto-generated random slug.</span>
                        </label>
                    <% } %>
                </div>
            </div>

            <div class="modal-action mt-6">
                <button type="button" onclick="closeSaveModal()" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="button" onclick="submitSave()" id="saveSubmitBtn" class="btn btn-primary btn-sm text-white">
                    <%= prefill && prefill.slug ? 'Save Updates' : 'Publish App' %>
                </button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button type="button" onclick="closeSaveModal()">close</button>
        </form>
    </dialog>

    <!-- Toast Notification (Feedback without reload) -->
    <div id="saveToast" class="toast toast-top toast-end z-50 transition-all duration-300 hidden">
        <div class="alert alert-success text-white shadow-xl flex items-center gap-2.5 text-xs font-semibold py-3 px-5 rounded-2xl">
            <svg class="w-4 h-4 stroke-current shrink-0" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span id="toastMessage">Deployment saved successfully!</span>
        </div>
    </div>

    <!-- Prefill JSON Data safely encoded to avoid breaking textarea or script HTML tags -->
    <script id="prefill-json" type="application/json">
        <%- JSON.stringify(prefill || null).replace(/</g, '\\u003c') %>
    </script>

    <script>
        let currentSlug = '<%= prefill && prefill.slug ? prefill.slug : "" %>';
        let currentTab = 'html';
        let combinedIsDirty = false;
        let consoleCount = 0;

        // 1. Toast Notification Helper
        function showToast(msg) {
            const toast = document.getElementById('saveToast');
            const toastMsg = document.getElementById('toastMessage');
            if (toast && toastMsg) {
                toastMsg.textContent = msg;
                toast.classList.remove('hidden');
                setTimeout(() => {
                    toast.classList.add('hidden');
                }, 3500);
            }
        }

        // 2. Active Textarea Selector
        function getActiveTextarea() {
            return document.getElementById(`${currentTab}Input`);
        }

        // 3. Safe Initialization of Textareas
        function initEditors() {
            const prefillEl = document.getElementById('prefill-json');
            let loaded = false;

            if (prefillEl && prefillEl.textContent.trim()) {
                try {
                    const data = JSON.parse(prefillEl.textContent);
                    if (data) {
                        document.getElementById('htmlInput').value = data.html || '';
                        document.getElementById('cssInput').value = data.css || '';
                        document.getElementById('jsInput').value = data.js || '';
                        loaded = true;
                    }
                } catch (err) {
                    console.error('[Fiddle] Error loading prefill data:', err);
                }
            }

            // If no prefill, check for auto-saved session draft
            if (!loaded && !currentSlug) {
                const draft = sessionStorage.getItem('fiddle_draft');
                if (draft) {
                    try {
                        const parsed = JSON.parse(draft);
                        if (parsed.html) document.getElementById('htmlInput').value = parsed.html;
                        if (parsed.css) document.getElementById('cssInput').value = parsed.css;
                        if (parsed.js) document.getElementById('jsInput').value = parsed.js;
                    } catch (e) {}
                }
            }

            updateLineNumbers();
            checkSplitHelperVisibility();
            runCode();
        }

        // 4. Synchronized Line Numbers & Status Bar
        function updateLineNumbers() {
            const ta = getActiveTextarea();
            if (!ta) return;
            const count = (ta.value.match(/\n/g) || []).length + 1;
            let nums = '';
            for (let i = 1; i <= count; i++) {
                nums += i + '\n';
            }
            const gutter = document.getElementById('lineNumbers');
            if (gutter) {
                gutter.textContent = nums;
                gutter.scrollTop = ta.scrollTop;
            }
            updateStatusInfo(ta, count);
        }

        function updateStatusInfo(ta, lineCount) {
            const count = lineCount || ((ta.value.match(/\n/g) || []).length + 1);
            document.getElementById('lineCount').textContent = count + (count === 1 ? ' line' : ' lines');
            document.getElementById('charCount').textContent = ta.value.length + ' chars';

            const start = ta.selectionStart;
            const textBefore = ta.value.substring(0, start);
            const lineNum = (textBefore.match(/\n/g) || []).length + 1;
            const colNum = start - textBefore.lastIndexOf('\n');
            document.getElementById('cursorPos').textContent = `Ln ${lineNum}, Col ${colNum}`;
            document.getElementById('tabModeLabel').textContent = currentTab.toUpperCase();
        }

        // 5. Helper: Indent lines of text
        function indentCode(str, numSpaces) {
            if (!str) return '';
            const pad = ' '.repeat(numSpaces);
            return str.split('\n').map(line => line.length ? pad + line : line).join('\n');
        }

        // 6. Build Complete Standalone HTML from HTML, CSS, JS inputs
        function buildCombinedCode() {
            const html = document.getElementById('htmlInput').value.trim();
            const css = document.getElementById('cssInput').value.trim();
            const js = document.getElementById('jsInput').value.trim();
            const title = (document.getElementById('saveTitle')?.value || '<%= prefill && prefill.title ? prefill.title : "Standalone Web Application" %>').trim();

            const isFullDoc = /^\s*<!DOCTYPE|^\s*<html/i.test(html);

            if (isFullDoc) {
                let combined = html;
                if (css) {
                    if (combined.includes('</head>')) {
                        combined = combined.replace('</head>', `  <style>\n${indentCode(css, 4)}\n  </style>\n</head>`);
                    } else {
                        combined = `<style>\n${css}\n</style>\n` + combined;
                    }
                }
                if (js) {
                    if (combined.includes('</body>')) {
                        combined = combined.replace('</body>', `  <` + `script>\n${indentCode(js, 4)}\n  <\x2fscript>\n</body>`);
                    } else {
                        combined += `\n<` + `script>\n${js}\n<\x2fscript>`;
                    }
                }
                return combined;
            } else {
                return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title || 'Standalone Web Application'}</title>
  <style>
${css ? indentCode(css, 4) : '    /* Custom CSS styles */'}
  </style>
</head>
<body>
${html ? indentCode(html, 2) : '  <!-- HTML Content -->'}

  <` + `script>
${js ? indentCode(js, 4) : '    // JavaScript code'}
  <\x2fscript>
</body>
</html>`;
            }
        }

        // 7. Parse Combined Code into separate HTML, CSS, and JS tabs
        function syncCombinedToTabs() {
            const combinedVal = document.getElementById('combinedInput').value;
            if (!combinedVal.trim()) return;

            let css = '';
            let js = '';

            let processed = combinedVal.replace(/<style[^>]*>([\s\S]*?)<\/style>/gi, (match, content) => {
                css += content.trim() + '\n\n';
                return '';
            });

            processed = processed.replace(/<script([^>]*)>([\s\S]*?)<\/script>/gi, (match, attrs, content) => {
                if (attrs && attrs.includes('src=')) return match;
                js += content.trim() + '\n\n';
                return '';
            });

            let html = processed;
            const bodyMatch = processed.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
            const headMatch = processed.match(/<head[^>]*>([\s\S]*?)<\/head>/i);

            if (bodyMatch) {
                let headElements = '';
                if (headMatch) {
                    const headContent = headMatch[1]
                        .replace(/<meta\s+charset=[^>]*>/gi, '')
                        .replace(/<meta\s+name=["']viewport["'][^>]*>/gi, '')
                        .replace(/<title[^>]*>[\s\S]*?<\/title>/gi, '')
                        .trim();
                    if (headContent) headElements = headContent + '\n\n';
                }
                html = headElements + bodyMatch[1].trim();
            } else {
                html = processed
                    .replace(/<!DOCTYPE html>/i, '')
                    .replace(/<html[^>]*>/i, '')
                    .replace(/<\/html>/i, '')
                    .trim();
            }

            document.getElementById('htmlInput').value = html.trim();
            document.getElementById('cssInput').value = css.trim();
            document.getElementById('jsInput').value = js.trim();
            combinedIsDirty = false;
        }

        // 8. Tab Switching
        function switchTab(type) {
            if (currentTab === 'combined' && type !== 'combined' && combinedIsDirty) {
                syncCombinedToTabs();
            }

            currentTab = type;

            if (type === 'combined' && !combinedIsDirty) {
                document.getElementById('combinedInput').value = buildCombinedCode();
            }

            document.querySelectorAll('.editor-area').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('button[id^="tab-"]').forEach(btn => {
                btn.className = 'flex-1 py-2.5 border-b-2 border-transparent text-neutral-400 hover:text-white transition-colors text-center';
            });

            const activeEditor = document.getElementById(`${type}Input`);
            if (activeEditor) {
                activeEditor.classList.remove('hidden');
                activeEditor.focus();
            }

            const activeBtn = document.getElementById(`tab-${type}`);
            if (activeBtn) {
                activeBtn.className = 'flex-1 py-2.5 border-b-2 border-primary text-primary bg-neutral-800/60 transition-colors text-center font-semibold';
            }

            updateLineNumbers();
            checkSplitHelperVisibility();
            runCode();
        }

        // 9. Code Comment Toggle Feature (HTML, CSS, JS, Combined)
        function toggleComment() {
            const ta = getActiveTextarea();
            if (!ta) return;
            const start = ta.selectionStart;
            const end = ta.selectionEnd;
            const val = ta.value;

            let openToken = '// ';
            let closeToken = '';
            let isBlock = false;

            if (currentTab === 'html') {
                openToken = '<!-- '; closeToken = ' -->'; isBlock = true;
            } else if (currentTab === 'css') {
                openToken = '/* '; closeToken = ' */'; isBlock = true;
            } else if (currentTab === 'combined') {
                const before = val.substring(0, start);
                const lastStyleOpen = before.lastIndexOf('<style');
                const lastStyleClose = before.lastIndexOf('<\x2fstyle>');
                const lastScriptOpen = before.lastIndexOf('<' + 'script');
                const lastScriptClose = before.lastIndexOf('<\x2fscript>');

                if (lastStyleOpen > lastStyleClose) {
                    openToken = '/* '; closeToken = ' */'; isBlock = true;
                } else if (lastScriptOpen > lastScriptClose) {
                    openToken = '// '; closeToken = ''; isBlock = false;
                } else {
                    openToken = '<!-- '; closeToken = ' -->'; isBlock = true;
                }
            }

            if (isBlock) {
                const selected = val.substring(start, end);
                if (selected.startsWith(openToken) && selected.endsWith(closeToken)) {
                    const unwrapped = selected.substring(openToken.length, selected.length - closeToken.length);
                    ta.setRangeText(unwrapped, start, end, 'select');
                } else {
                    ta.setRangeText(openToken + selected + closeToken, start, end, 'select');
                }
            } else {
                const lineStart = val.lastIndexOf('\n', start - 1) + 1;
                let lineEnd = val.indexOf('\n', end);
                if (lineEnd === -1) lineEnd = val.length;

                const linesText = val.substring(lineStart, lineEnd);
                const linesArr = linesText.split('\n');
                const allCommented = linesArr.every(l => l.trim().startsWith('//'));

                let newLines;
                if (allCommented) {
                    newLines = linesArr.map(l => l.replace(/^\s*\/\/\s?/, l.match(/^\s*/)[0]));
                } else {
                    newLines = linesArr.map(l => l.length ? '// ' + l : l);
                }
                ta.setRangeText(newLines.join('\n'), lineStart, lineEnd, 'select');
            }

            ta.dispatchEvent(new Event('input'));
        }

        // 10. Code Formatter / Tidy Indentation
        function formatActiveCode() {
            const ta = getActiveTextarea();
            if (!ta) return;
            const code = ta.value;

            try {
                if (currentTab === 'css') {
                    // Simple CSS Formatter
                    const formatted = code
                        .replace(/\s*\{\s*/g, ' {\n  ')
                        .replace(/\s*;\s*/g, ';\n  ')
                        .replace(/\s*\}\s*/g, '\n}\n\n')
                        .trim();
                    ta.value = formatted;
                } else if (currentTab === 'js') {
                    // JS newline normalization
                    const formatted = code
                        .replace(/;\s*/g, ';\n')
                        .replace(/\{\s*/g, ' {\n  ')
                        .replace(/\}\s*/g, '\n}\n')
                        .trim();
                    ta.value = formatted;
                } else {
                    // HTML tag spacing
                    const formatted = code
                        .replace(/>\s*</g, '>\n<')
                        .trim();
                    ta.value = formatted;
                }
                ta.dispatchEvent(new Event('input'));
                showToast('Code formatting applied!');
            } catch(e) {
                showToast('Could not format code.');
            }
        }

        // 11. Copy All Working Standalone HTML
        function copyCombinedCode() {
            const code = currentTab === 'combined' ? document.getElementById('combinedInput').value : buildCombinedCode();
            if (!code.trim()) {
                showToast('No code to copy!');
                return;
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(code).then(() => {
                    showToast('Copied standalone working HTML! Ready to paste anywhere.');
                }).catch(() => fallbackCopy(code));
            } else {
                fallbackCopy(code);
            }
        }

        function fallbackCopy(text) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showToast('Copied standalone working HTML! Ready to paste anywhere.');
        }

        // 12. Clear All Editors
        function clearAllCode() {
            if (confirm('Are you sure you want to clear all HTML, CSS, and JavaScript code in the editor?')) {
                document.getElementById('htmlInput').value = '';
                document.getElementById('cssInput').value = '';
                document.getElementById('jsInput').value = '';
                document.getElementById('combinedInput').value = '';
                document.getElementById('preview').srcdoc = '';
                sessionStorage.removeItem('fiddle_draft');
                combinedIsDirty = false;
                updateLineNumbers();
                checkSplitHelperVisibility();
                clearConsoleLog();
                showToast('All code cleared.');
            }
        }

        // 13. Smart Split helper: extracts inline <style> and <script> from HTML tab
        function checkSplitHelperVisibility() {
            const htmlVal = document.getElementById('htmlInput').value;
            const helperBtn = document.getElementById('splitHelperBtn');
            const hasInlineTags = /<style[^>]*>[\s\S]*?<\/style>/i.test(htmlVal) || /<script(?![^>]*src=)[^>]*>[\s\S]*?<\/script>/i.test(htmlVal);

            if (hasInlineTags && currentTab === 'html') {
                helperBtn.classList.remove('hidden');
            } else {
                helperBtn.classList.add('hidden');
            }
        }

        function smartExtractInlineCode() {
            let htmlVal = document.getElementById('htmlInput').value;
            let currentCss = document.getElementById('cssInput').value;
            let currentJs = document.getElementById('jsInput').value;
            let extractedCss = '';
            let extractedJs = '';

            htmlVal = htmlVal.replace(/<style[^>]*>([\s\S]*?)<\/style>/gi, (match, content) => {
                extractedCss += content.trim() + '\n\n';
                return '';
            });

            htmlVal = htmlVal.replace(/<script([^>]*)>([\s\S]*?)<\/script>/gi, (match, attrs, content) => {
                if (attrs && attrs.includes('src=')) return match;
                extractedJs += content.trim() + '\n\n';
                return '';
            });

            document.getElementById('htmlInput').value = htmlVal.trim();
            if (extractedCss.trim()) {
                document.getElementById('cssInput').value = (currentCss ? currentCss.trim() + '\n\n' : '') + extractedCss.trim();
            }
            if (extractedJs.trim()) {
                document.getElementById('jsInput').value = (currentJs ? currentJs.trim() + '\n\n' : '') + extractedJs.trim();
            }

            updateLineNumbers();
            checkSplitHelperVisibility();
            runCode();
            showToast('Split inline <style> into CSS tab and <script> into JS tab!');
        }

        // 14. Responsive Viewport Mode (Desktop / Tablet / Mobile)
        function setPreviewViewport(width) {
            const wrapper = document.getElementById('previewWrapper');
            wrapper.style.maxWidth = width;

            ['vp-desktop', 'vp-tablet', 'vp-mobile'].forEach(id => {
                const btn = document.getElementById(id);
                btn.className = 'btn btn-ghost btn-xs text-neutral-400 hover:text-white join-item px-2 py-0 h-6';
            });

            if (width === '100%') document.getElementById('vp-desktop').className = 'btn btn-ghost btn-xs text-primary join-item px-2 py-0 h-6';
            else if (width === '768px') document.getElementById('vp-tablet').className = 'btn btn-ghost btn-xs text-primary join-item px-2 py-0 h-6';
            else if (width === '375px') document.getElementById('vp-mobile').className = 'btn btn-ghost btn-xs text-primary join-item px-2 py-0 h-6';
        }

        // 15. Built-in Console Log Capture
        function toggleConsoleDrawer() {
            const drawer = document.getElementById('consoleDrawer');
            drawer.classList.toggle('hidden');
        }

        function clearConsoleLog() {
            document.getElementById('consoleLogs').innerHTML = '<div class="text-neutral-600 text-[11px] italic">Console cleared.</div>';
            consoleCount = 0;
            document.getElementById('consoleBadge').textContent = '0';
        }

        function appendConsoleLog(level, message, time) {
            consoleCount++;
            document.getElementById('consoleBadge').textContent = consoleCount;

            const container = document.getElementById('consoleLogs');
            const row = document.createElement('div');
            row.className = 'flex items-start gap-2 py-0.5 border-b border-neutral-900 leading-snug';

            let badgeClass = 'badge-neutral text-neutral-400';
            if (level === 'warn') badgeClass = 'badge-warning text-yellow-900';
            if (level === 'error') badgeClass = 'badge-error text-white';

            row.innerHTML = `
                <span class="text-[10px] text-neutral-600 shrink-0 font-mono">${time || ''}</span>
                <span class="badge badge-xs ${badgeClass} font-mono uppercase text-[9px] shrink-0">${level}</span>
                <span class="text-neutral-200 flex-1 break-words font-mono text-[11px]">${escapeHtml(message)}</span>
            `;
            container.appendChild(row);
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        window.addEventListener('message', (e) => {
            if (e.data && e.data.type === 'FIDDLE_CONSOLE') {
                appendConsoleLog(e.data.level, e.data.message, e.data.time);
            }
        });

        // 16. Code Execution in Preview Iframe
        function runCode() {
            let source = '';
            if (currentTab === 'combined') {
                source = document.getElementById('combinedInput').value;
            } else {
                source = buildCombinedCode();
            }

            // Inject lightweight console capture hook into iframe
            const consoleHook = '<' + 'script>\n' +
`(function() {
  function _send(type, args) {
    try {
      var str = Array.prototype.map.call(args, function(item) {
        if (typeof item === 'object') {
          try { return JSON.stringify(item); } catch(e) { return String(item); }
        }
        return String(item);
      }).join(' ');
      window.parent.postMessage({ type: 'FIDDLE_CONSOLE', level: type, message: str, time: new Date().toLocaleTimeString() }, '*');
    } catch(err) {}
  }
  var _log = console.log, _warn = console.warn, _err = console.error;
  console.log = function() { _send('log', arguments); _log.apply(console, arguments); };
  console.warn = function() { _send('warn', arguments); _warn.apply(console, arguments); };
  console.error = function() { _send('error', arguments); _err.apply(console, arguments); };
})();\n` + '<\x2fscript>';

            if (source.includes('<head>')) {
                source = source.replace('<head>', '<head>' + consoleHook);
            } else {
                source = consoleHook + source;
            }

            document.getElementById('preview').srcdoc = source;
        }

        // 17. Auto-save Draft
        function autoSaveDraft() {
            if (!currentSlug) {
                const draft = {
                    html: document.getElementById('htmlInput').value,
                    css: document.getElementById('cssInput').value,
                    js: document.getElementById('jsInput').value
                };
                sessionStorage.setItem('fiddle_draft', JSON.stringify(draft));
            }
        }

        // 18. Attach Input, Scroll, Cursor & Smart Bracket Listeners to Textareas
        const bracketPairs = { '(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`' };

        ['htmlInput', 'cssInput', 'jsInput', 'combinedInput'].forEach(id => {
            const el = document.getElementById(id);

            // Sync scroll with line numbers
            el.addEventListener('scroll', () => {
                const gutter = document.getElementById('lineNumbers');
                if (gutter) gutter.scrollTop = el.scrollTop;
            });

            // Sync input changes
            el.addEventListener('input', () => {
                if (id === 'combinedInput') combinedIsDirty = true;
                else combinedIsDirty = false;
                updateLineNumbers();
                checkSplitHelperVisibility();
                autoSaveDraft();
            });

            // Cursor movement updates
            el.addEventListener('click', () => updateStatusInfo(el));
            el.addEventListener('keyup', (e) => {
                if (!['Control', 'Shift', 'Alt', 'Meta'].includes(e.key)) {
                    updateStatusInfo(el);
                }
            });

            // Keyboard Shortcuts: Tab indent, Auto-Brackets, Toggle Comment (Ctrl+/), Auto-Indent on Enter
            el.addEventListener('keydown', function(e) {
                // 1. Toggle Comment (Ctrl+/ or Cmd+/)
                if ((e.ctrlKey || e.metaKey) && e.key === '/') {
                    e.preventDefault();
                    toggleComment();
                    return;
                }

                // 2. Tab Key
                if (e.key === 'Tab') {
                    e.preventDefault();
                    this.setRangeText('  ', this.selectionStart, this.selectionStart, 'end');
                    this.dispatchEvent(new Event('input'));
                    return;
                }

                // 3. Auto-indent on Enter
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const start = this.selectionStart;
                    const val = this.value;
                    const lineStart = val.lastIndexOf('\n', start - 1) + 1;
                    const currentLine = val.substring(lineStart, start);
                    const indentMatch = currentLine.match(/^\s*/);
                    let indent = indentMatch ? indentMatch[0] : '';

                    const lastChar = currentLine.trim().slice(-1);
                    if (['{', '(', '[', ':'].includes(lastChar)) {
                        indent += '  ';
                    }

                    this.setRangeText('\n' + indent, start, start, 'end');
                    this.dispatchEvent(new Event('input'));
                    return;
                }

                // 4. Auto-Close Brackets & Quotes
                if (bracketPairs[e.key]) {
                    const closeChar = bracketPairs[e.key];
                    const start = this.selectionStart;
                    const end = this.selectionEnd;

                    if (start !== end) {
                        e.preventDefault();
                        const selected = this.value.substring(start, end);
                        this.setRangeText(e.key + selected + closeChar, start, end, 'select');
                        this.dispatchEvent(new Event('input'));
                        return;
                    } else if (e.key === '"' || e.key === "'" || e.key === '`') {
                        // Skip if already next to matching closing quote
                        if (this.value.charAt(start) === e.key) {
                            e.preventDefault();
                            this.setSelectionRange(start + 1, start + 1);
                            return;
                        }
                    }

                    e.preventDefault();
                    this.setRangeText(e.key + closeChar, start, start, 'end');
                    this.setSelectionRange(start + 1, start + 1);
                    this.dispatchEvent(new Event('input'));
                    return;
                }

                // 5. Backspace between empty bracket pairs
                if (e.key === 'Backspace') {
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    if (start === end && start > 0) {
                        const prev = this.value.charAt(start - 1);
                        const next = this.value.charAt(start);
                        if (bracketPairs[prev] === next) {
                            e.preventDefault();
                            this.setRangeText('', start - 1, start + 1, 'end');
                            this.dispatchEvent(new Event('input'));
                            return;
                        }
                    }
                }
            });
        });

        // Split Panel Resizer
        const resizer = document.getElementById('resizer');
        const leftSide = document.getElementById('editorPanel');
        const overlay = document.getElementById('iframeOverlay');
        let x = 0;
        let leftWidth = 0;

        resizer.addEventListener('mousedown', (e) => {
            x = e.clientX;
            leftWidth = leftSide.getBoundingClientRect().width;
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
            overlay.classList.remove('hidden');
            resizer.classList.add('active');
            document.body.style.cursor = 'col-resize';
        });

        function onMouseMove(e) {
            leftSide.style.width = `${Math.max(200, leftWidth + (e.clientX - x))}px`;
        }

        function onMouseUp() {
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            overlay.classList.add('hidden');
            resizer.classList.remove('active');
            document.body.style.cursor = 'default';
        }

        // Modal Controls
        function openSaveModal() {
            document.getElementById('save_modal').showModal();
        }

        function closeSaveModal() {
            document.getElementById('save_modal').close();
        }

        // 19. Save / Publish Application Without Reloading
        async function submitSave() {
            if (currentTab === 'combined' && combinedIsDirty) {
                syncCombinedToTabs();
            }

            const slug = document.getElementById('saveSlug').value.trim();
            const title = document.getElementById('saveTitle').value.trim();
            const btn = document.getElementById('saveSubmitBtn');

            const payload = {
                html: document.getElementById('htmlInput').value,
                css: document.getElementById('cssInput').value,
                js: document.getElementById('jsInput').value,
                slug: slug || currentSlug,
                title
            };

            btn.textContent = 'Saving...';
            btn.disabled = true;

            try {
                // Native fetch as per guideline 5
                const res = await fetch('/fiddle/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) {
                    sessionStorage.removeItem('fiddle_draft');
                    closeSaveModal();

                    const savedSlug = result.slug || slug || currentSlug;
                    currentSlug = savedSlug;

                    // Update URL without any page reload
                    history.replaceState(null, '', '/fiddle/' + savedSlug);

                    // Reveal Public Site Link in Top Bar
                    const publicLink = document.getElementById('publicSiteLink');
                    if (publicLink) {
                        publicLink.href = '/sites/' + savedSlug + '/';
                        publicLink.classList.remove('hidden');
                    }

                    // Lock slug input for future saves
                    const slugInput = document.getElementById('saveSlug');
                    if (slugInput) {
                        slugInput.value = savedSlug;
                        slugInput.readOnly = true;
                        slugInput.classList.add('bg-base-200', 'cursor-not-allowed');
                    }

                    // Update UI labels in navbar & modal
                    const navBtnText = document.getElementById('publishNavBtnText');
                    if (navBtnText) navBtnText.textContent = 'Update Deployment';
                    document.getElementById('saveSubmitBtn').textContent = 'Save Updates';
                    const modalTitle = document.getElementById('modalTitleText');
                    if (modalTitle) modalTitle.textContent = 'Update Deployment';

                    // Update header slug badge
                    const badgeContainer = document.getElementById('slugBadgeContainer');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = `<span class="badge badge-neutral badge-sm font-mono text-[11px] text-primary">Editing: ${savedSlug}</span>`;
                    }

                    // Refresh preview iframe with latest saved code
                    runCode();

                    // Show success feedback
                    showToast('Deployment updated! Live at /sites/' + savedSlug + '/');
                } else {
                    alert('Error: ' + (result.error || 'Unknown error saving'));
                }
            } catch (e) {
                console.error('[Fiddle] Save error:', e);
                alert('Connection error while saving project.');
            } finally {
                btn.textContent = currentSlug ? 'Save Updates' : 'Publish App';
                btn.disabled = false;
            }
        }

        window.onload = initEditors;
    </script>
</body>
</html>